{
  "name": "scanline",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/ui": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "^1.6.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "xcode": "^3.0.1"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:swift": "swiftc -O ios/Kart/KartDetector.swift ios/Kart/MaskContour.swift ios/Kart/FrameMetrics.swift ios/Kart/KartImageTools.swift scripts/swift-tests/main.swift -o /tmp/kart-swift-tests && /tmp/kart-swift-tests",
    "bench:detector": "swiftc -O ios/Kart/KartDetector.swift ios/Kart/MaskContour.swift ios/Kart/FrameMetrics.swift ios/Kart/AppleInstanceMaskDetector.swift scripts/detector-bench/main.swift -o /tmp/kart-detector-bench && /tmp/kart-detector-bench",
    "xcode:register": "node scripts/register-xcode-file.js"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/"
    ]
  },
  "private": true
}
