+// React Native 0.74 and newer run bridgeless, and there `RCTCxxBridge.runtime` is always null, so
+// the `install` method below can never reach a jsi::Runtime through the bridge. The supported
+// replacement is `installJSIBindingsWithRuntime:callInvoker:`: RCTTurboModuleManager calls it with
+// the real runtime and CallInvoker right after it builds this TurboModule, which is before any
+// JavaScript reads `global.Worklets`.
+//
+// These two hold what that hook was handed. Libraries layered on worklets-core, specifically
+// react-native-vision-camera's frame processors, have the same dead bridge problem and need to
+// install into the same runtime this context was initialized with, so they read them back through
+// the two accessors below rather than reaching for a bridge that no longer carries a runtime.
+static facebook::jsi::Runtime *gWorkletsRuntime = nullptr;
+static std::shared_ptr<facebook::react::CallInvoker> gWorkletsCallInvoker = nullptr;
+
+extern "C" facebook::jsi::Runtime *WKTGetInstalledJsRuntime(void) {
+  return gWorkletsRuntime;
+}
+
+// Writes through an out parameter rather than returning: a C-linkage function may not return a
+// std::shared_ptr, and -Wreturn-type-c-linkage is an error in this build.
+extern "C" void WKTCopyInstalledCallInvoker(
+    std::shared_ptr<facebook::react::CallInvoker> *outCallInvoker) {
+  if (outCallInvoker != nullptr) {
+    *outCallInvoker = gWorkletsCallInvoker;
+  }
+}
