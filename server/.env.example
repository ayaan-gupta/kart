OPENAI_API_KEY=sk-proj-replace-me

# Where the grounded enumerator runs. Optional: with this unset the census still names
# everything it can see and the shopper still gets a bag, it just has no outlines in it.
# What to deploy behind this URL: the reference implementation of the far side is
# runs/2026-08-16-pipeline-run/harness/grounded.py, and the wire contract this end expects is
# server/src/enumerate.ts. To run one locally instead, see gap 2 in docs/running-on-a-phone.md.
ENUMERATOR_URL=
ENUMERATOR_TOKEN=

# Optional. Points the client at another endpoint instead of OpenAI's own: a second
# organisation or key, a gateway or proxy, or Azure OpenAI. Useful when the usual
# account has no credit. Leave unset to use OpenAI.
#
# NOT a local model server. Everything goes through the Responses API
# (openai.responses.create) with json_schema strict mode, and llama.cpp, vLLM, Ollama
# and mlx-vlm all implement /v1/chat/completions instead. Pointing this at one gives a
# 404 on the first request.
# OPENAI_BASE_URL=https://your-endpoint.example/v1
